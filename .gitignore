# Installed dependencies and a project-local pnpm store
/node_modules/
/.pnpm-store/

# Astro build output, generated types, and dev/preview state
/dist/
/.astro/

# Wrangler local cache, logs, and state
/.wrangler/

# Local environment values; keep the shared template
.env
.env.*
!.env.example

# Temporary Markdown files created by atomic content publishing
/content/**/.*.md.*.tmp

# pnpm diagnostics
/pnpm-debug.log*

# Personal Claude Code settings and instructions
/.claude/settings.local.json
CLAUDE.local.md

# macOS metadata
.DS_Store

# Serialize article creation and publication
/content/writing/.authoring.lock
