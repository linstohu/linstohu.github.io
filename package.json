{
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "astro": "7.4.7"
  },
  "name": "linsto-org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist && node --env-file-if-exists=.env scripts/check-build.mjs",
    "preview": "astro preview",
    "new": "node --env-file-if-exists=.env scripts/content.mjs new",
    "audio": "node --env-file-if-exists=.env scripts/audio.mjs",
    "media": "node --env-file-if-exists=.env scripts/media.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preinstall": "node scripts/check-package-manager.mjs",
    "test": "node --test tests/*.test.ts",
    "validate": "pnpm format:check && pnpm test && pnpm check && pnpm build",
    "publish:content": "node --env-file-if-exists=.env scripts/content.mjs publish"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/lib-storage": "3.1164.0",
    "@types/node": "24.19.2",
    "music-metadata": "12.3.5",
    "pagefind": "1.6.0",
    "parse5": "8.1.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.158.0",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0"
}
