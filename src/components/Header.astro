---
import '../styles/components/header.css';
import { site } from '../lib/site';
import Disclosure from './ui/Disclosure.astro';
interface Props {
  section: string;
}
const { section } = Astro.props;
const Brand = section === 'home' ? 'h1' : 'a';
const pages = [
  ['home', '/', '首页'],
  ['writing', '/writing/', '文字'],
  ['audio', '/audio/', '声音'],
  ['now', '/now/', '此刻'],
  ['about', '/about/', '关于'],
];
---

<header data-site-header data-home-art={section === 'home' || undefined}>
  <Disclosure
    class="wrap"
    id="primary-navigation"
    panelAs="nav"
    panelLabel="主导航"
    triggerClass="mobile-menu"
    toggleLabel="网站导航"
    dismissible
  >
    <Brand
      slot="leading"
      class="brand"
      href={section === 'home' ? undefined : '/'}
      tabindex={section === 'home' ? -1 : undefined}
      aria-label={section === 'home' ? undefined : `${site.title} · 首页`}
    >
      <span class="greeting">{site.greeting}</span>{' '}
      <span class="name">{site.name}</span>
    </Brand>
    <Fragment slot="trigger">
      <span>导航</span>
      <span class="menu-glyph" aria-hidden="true"></span>
    </Fragment>
    {pages.map(([key, url, label]) => (
      <a href={url} aria-current={section === key ? 'page' : undefined}>
        {label}
      </a>
    ))}
  </Disclosure>
</header>
