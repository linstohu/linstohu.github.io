---
import { site } from '../lib/site';
interface Props {
  section: string;
}
const { section } = Astro.props;
const Brand = section === 'home' ? 'h1' : 'a';
const pages = [
  ['home', '/', '首页'],
  ['writing', '/writing/', '文字'],
  ['audio', '/audio/', '声音'],
  ['now', '/now/', '此刻'],
  ['about', '/about/', '关于'],
];
---

<header data-site-header data-home-art={section === 'home' || undefined}>
  <div class="wrap">
    <Brand
      class="brand"
      href={section === 'home' ? undefined : '/'}
      tabindex={section === 'home' ? -1 : undefined}
      aria-label={section === 'home' ? undefined : `${site.title} · 首页`}
    >
      <span class="greeting">{site.greeting}</span>{' '}
      <span class="name">{site.name}</span>
    </Brand>
    <nav id="primary-navigation" aria-label="主导航">
      {pages.map(([key, url, label]) => (
        <a href={url} aria-current={section === key ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <button
      class="mobile-menu"
      aria-label="展开网站导航"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span>导航</span>
      <span class="menu-glyph" aria-hidden="true"></span>
    </button>
  </div>
</header>
