---
interface Props {
  episode: string;
}
const { episode } = Astro.props;
---

<span class="episode-number" aria-label={`第${episode}期`}>
  EP.{episode}
</span>
<style>
  @layer theme, base, components, utilities;
  @layer components {
    .episode-number {
      color: var(--accent);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.06em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
  }
</style>
