---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolve } from 'node:path';
import sharp from 'sharp';

interface Props {
  src: string;
  alt?: string;
  variant?: 'home' | 'about';
}
const { src, alt = '', variant = 'home' } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/public/**/*.{avif,jpeg,jpg,png,webp}',
);
const source = await images[`/public${src}`]?.();
const image = source?.default;
const widths = image
  ? [...new Set([480, 640, image.width])]
      .filter((width) => width <= image.width)
      .sort((a, b) => a - b)
  : [];
const [avif, webp, preview] = image
  ? await Promise.all([
      getImage({ src: image, widths, format: 'avif', quality: 65 }),
      getImage({ src: image, widths, format: 'webp', quality: 85 }),
      sharp(resolve('public', src.slice(1)))
        .resize({ width: 64, withoutEnlargement: true })
        .blur(1.2)
        .webp({ quality: 60 })
        .toBuffer(),
    ])
  : [];
// The phone layout crops the painting to a taller frame than its native ratio.
const sizes =
  variant === 'home'
    ? '(max-width: 760px) calc(100vw + 160px), 100vw'
    : '(max-width: 760px) calc(100vw - 40px), (max-width: 900px) 40vw, 480px';
---

<picture
  class={`${variant}-artwork`}
  style={
    preview &&
    `background-image: url("data:image/webp;base64,${preview.toString('base64')}")`
  }
>
  {avif && (
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  )}
  <img
    class={variant === 'home' ? 'mountains' : undefined}
    data-home-art={variant === 'home' || undefined}
    draggable="false"
    src={webp?.src ?? src}
    srcset={webp?.srcSet.attribute}
    sizes={webp && sizes}
    width={image?.width ?? 900}
    height={image?.height ?? 480}
    alt={alt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />
</picture>

<style>
  picture {
    display: block;
    background-size: cover;
    background-position: 38% 0;
  }
  .about-artwork {
    background-position: 50% 35%;
  }
</style>
