---
import PageHeading from './ui/PageHeading.astro';
import '../styles/pages/collections.css';
import {
  loadContent,
  collectionTags,
  address,
  dateLabel,
  audioLabel,
  type Writing,
  type Audio,
} from '../lib/content';
import { site } from '../lib/site';
import { durationLabel } from '../lib/duration';
import { articleExcerpt } from '../lib/excerpt';
import AudioCover from './AudioCover.astro';
import Row from './Row.astro';
import Disclosure from './ui/Disclosure.astro';
interface Props {
  group: 'writing' | 'audio' | 'archive';
}
const { group } = Astro.props;
const { posts, sounds, snapshots, series } = await loadContent();
const isCollection = group !== 'archive';
const entries =
  group === 'writing'
    ? posts
    : group === 'audio'
      ? sounds
      : [...posts, ...sounds, ...snapshots].sort(
          (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
        );
const latest = entries[0];
const article = group === 'writing' ? (latest as Writing) : undefined;
const excerpt =
  article &&
  (article.data.featuredExcerpt ||
    articleExcerpt(article.rendered?.html ?? '', article.data.description));
const sound = group === 'audio' ? (latest as Audio) : undefined;
const show = sound
  ? series.find((item) => item.id === sound.data.series)
  : undefined;
const label = group === 'writing' ? '文字' : '声音';
const subtitle =
  group === 'writing' ? site.writingSubtitle : site.audioSubtitle;
const tags = [
  ...new Set(
    entries.flatMap((entry) =>
      collectionTags(entry, series, group === 'archive'),
    ),
  ),
];
---

<section
  class:list={[{ 'collection-index': isCollection }, `${group}-collection`]}
  data-collection={entries.length > 0 || undefined}
  data-group={group}
  data-latest={
    isCollection && latest
      ? latest.collection +
        ':' +
        (latest.collection === 'now' ? latest.data.period : latest.data.slug)
      : ''
  }
>
  {isCollection ? (
    <PageHeading title={label} description={subtitle} />
  ) : (
    <div class="page">
      <span class="eyebrow">ARCHIVE</span>
      <h1>全部归档</h1>
      <p class="intro">按时间翻阅文字、声音与此刻，也可以输入关键词查找。</p>
    </div>
  )}
  {article && (
    <section
      class="collection-feature writing-feature grid grid-cols-1 md:grid-cols-[1.14fr_1fr]"
      data-feature
      aria-label="最新文章"
    >
      <div class="feature-copy">
        <div class="feature-meta">
          <span>
            最新文字{article.data.category && ' · ' + article.data.category}
          </span>
          <time datetime={article.data.publishedAt.toISOString()}>
            {dateLabel(article.data.publishedAt)}
          </time>
        </div>
        <h2>
          <a href={address(article)}>{article.data.title}</a>
        </h2>
        {excerpt !== article.data.description && (
          <p>{article.data.description}</p>
        )}
        <a class="more" href={address(article)}>
          读这篇文章 →
        </a>
      </div>
      <Disclosure
        as="blockquote"
        class="feature-fragment"
        id="fragment-copy"
        panelClass="fragment-copy"
        triggerClass="fragment-toggle"
      >
        <span slot="leading" class="fragment-label">
          文中一段
        </span>
        <Fragment slot="trigger">
          <span>读一段正文</span>
          <span class="disclosure-glyph" aria-hidden="true"></span>
        </Fragment>
        <p>{excerpt}</p>
        <cite>
          <a href={address(article)}>
            摘自「{article.data.excerptTitle || article.data.title}」 ↗
          </a>
        </cite>
      </Disclosure>
    </section>
  )}
  {sound && (
    <section
      class="collection-feature podcast-feature"
      data-feature
      aria-label="最新声音"
    >
      <a
        class:list={['show-cover', { 'recording-cover': !show }]}
        href={address(sound)}
        aria-label={`打开${show?.data.title || '声音手记'}`}
      >
        <AudioCover show={show} />
      </a>
      <div class="feature-copy">
        <div class="feature-meta">
          <span>最新声音 · {audioLabel(sound, series)}</span>
          <time datetime={sound.data.publishedAt.toISOString()}>
            {dateLabel(sound.data.publishedAt)}
          </time>
        </div>
        <h2>
          <a href={address(sound)}>{sound.data.title}</a>
        </h2>
        <p>{sound.data.description}</p>
        <div class="episode-actions">
          {sound.data.listen?.[0] ? (
            <>
              <a
                class="episode-link"
                href={sound.data.listen[0].url}
                target="_blank"
                rel="noopener noreferrer"
              >
                去{sound.data.listen[0].platform}收听 ↗
              </a>
              <a class="more" href={address(sound)}>
                单集笔记 →
              </a>
            </>
          ) : (
            <a class="episode-link" href={address(sound)}>
              收听这段声音 →
            </a>
          )}
          {sound.data.duration && (
            <span class="episode-length">
              音频时长 {durationLabel(sound.data.duration)}
            </span>
          )}
        </div>
      </div>
    </section>
  )}
  {entries.length === 0 ? (
    <p class="empty-list">暂无{isCollection ? label : '记录'}。</p>
  ) : (
    <section class="collection-browser" aria-label="查找内容">
      {group === 'audio' && (
        <div
          class="audio-sources grid grid-cols-2 md:grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))]"
          aria-label="选择声音栏目"
        >
          {tags.map((tag) => {
            const item = series.find((entry) => entry.data.title === tag);
            const count = sounds.filter((entry) =>
              collectionTags(entry, series, false).includes(tag),
            ).length;
            return (
              <div class="audio-source-card">
                <button
                  class="audio-source"
                  data-filter={tag}
                  aria-pressed="false"
                >
                  <span class="eyebrow">{item ? '栏目' : '独立录音'}</span>
                  <strong>{tag}</strong>
                  <span class="source-description">
                    {item?.data.description ||
                      '独白、现场，以及随手留下的声音。'}
                  </span>
                  <span class="source-count">
                    {count} {item ? '期' : '条'}
                    <span aria-hidden="true">↗</span>
                  </span>
                </button>
                {item && item.data.listen?.length > 0 && (
                  <div class="source-platforms">
                    {item.data.listen.map((link) => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        在{link.platform}订阅 ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
      <div class="browse-heading">
        <h2 data-browse-heading>
          {isCollection ? '浏览' + label : '查找记录'}
        </h2>
        <input
          type="search"
          aria-label="搜索内容"
          placeholder={
            group === 'writing'
              ? '搜索文章内容…'
              : group === 'audio'
                ? '搜索声音内容…'
                : '搜索全部内容…'
          }
        />
        <script is:inline>
          {
            const input = document.currentScript?.previousElementSibling;
            if (input instanceof HTMLInputElement)
              input.value = new URLSearchParams(location.search).get('q') || '';
          }
        </script>
      </div>
      <div class="index-controls">
        <div class="filters" aria-label="分类筛选">
          {['全部', ...(group === 'audio' ? [] : tags)].map((tag) => (
            <button
              data-filter={tag}
              aria-pressed={tag === '全部' ? 'true' : 'false'}
            >
              {tag}
            </button>
          ))}
        </div>
        <span class="mono muted" role="status">
          {isCollection ? Math.max(0, entries.length - 1) : entries.length}{' '}
          {group === 'writing'
            ? '篇文字'
            : group === 'audio'
              ? '条声音'
              : '条记录'}
        </span>
      </div>
      <p class="search-notice" hidden></p>
      <div id="rows">
        {entries.map((entry, index) => (
          <Row
            entry={entry}
            series={series}
            variant={group}
            initiallyHidden={isCollection && index === 0}
          />
        ))}
        <p class="empty-list" hidden={entries.length > 0}>
          下一份记录，会留在这里。
        </p>
      </div>
    </section>
  )}
</section>
