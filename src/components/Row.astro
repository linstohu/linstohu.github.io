---
import EpisodeNumber from './EpisodeNumber.astro';
import {
  address,
  collectionTags,
  dateLabel,
  audioLabel,
  entryKey,
  searchMetadata,
  type Writing,
  type Audio,
  type Snapshot,
} from '../lib/content';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: Writing | Audio | Snapshot;
  series: CollectionEntry<'series'>[];
  variant?: 'generic' | 'writing' | 'audio' | 'archive';
  initiallyHidden?: boolean;
}
const {
  entry,
  series,
  variant = 'generic',
  initiallyHidden = false,
} = Astro.props;
const label =
  entry.collection === 'audio'
    ? audioLabel(entry, series)
    : entry.collection === 'now'
      ? '月份快照'
      : entry.data.category;
const key = entryKey(entry);
const tags = collectionTags(entry, variant === 'archive');
const showTitle =
  entry.collection === 'audio'
    ? series.find((item) => item.id === entry.data.series)?.data.title
    : undefined;
const searchText = [entry.data.title, searchMetadata(entry, showTitle), ...tags]
  .join(' ')
  .toLowerCase();
---

{variant === 'audio' && entry.collection === 'audio' ? (
  <a
    class="episode-row"
    href={address(entry)}
    data-entry-key={key}
    data-tags={JSON.stringify(tags)}
    data-search-text={searchText}
    hidden={initiallyHidden}
  >
    <div class="episode-copy">
      <div class="episode-meta">
        {entry.data.episode && <EpisodeNumber episode={entry.data.episode} />}
        <span class="episode-series">{showTitle ?? '声音手记'}</span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {dateLabel(entry.data.publishedAt)}
        </time>
      </div>
      <h3>{entry.data.title}</h3>
      <p>{entry.data.description}</p>
    </div>
    <span class="episode-row-action" aria-hidden="true">
      ↗
    </span>
  </a>
) : (
  <a
    class:list={['row', { 'writing-row': variant === 'writing' }]}
    data-category={
      entry.collection === 'writing' ? entry.data.category : undefined
    }
    href={address(entry)}
    data-entry-key={key}
    data-tags={JSON.stringify(tags)}
    data-search-text={searchText}
    hidden={initiallyHidden}
  >
    <time datetime={entry.data.publishedAt.toISOString()}>
      {variant === 'writing' || variant === 'archive'
        ? dateLabel(entry.data.publishedAt)
        : dateLabel(entry.data.publishedAt).slice(5)}
    </time>
    <span>
      <small>
        {variant === 'writing'
          ? label
          : { writing: '文字', audio: '声音', now: '此刻' }[entry.collection] +
            (label ? ' / ' + label : '')}
      </small>
      <strong>{entry.data.title}</strong>
      {variant === 'writing' && entry.collection === 'writing' && (
        <p>{entry.data.description}</p>
      )}
    </span>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
)}
