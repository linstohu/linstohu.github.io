---
import {
  address,
  collectionTags,
  dateLabel,
  audioLabel,
  type Writing,
  type Audio,
  type Snapshot,
} from '../lib/content';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: Writing | Audio | Snapshot;
  series: CollectionEntry<'series'>[];
  variant?: string;
  initiallyHidden?: boolean;
}
const {
  entry,
  series,
  variant = 'generic',
  initiallyHidden = false,
} = Astro.props;
const label =
  entry.collection === 'audio'
    ? audioLabel(entry, series)
    : entry.collection === 'now'
      ? '月份快照'
      : entry.data.category;
const key =
  entry.collection +
  ':' +
  (entry.collection === 'now' ? entry.data.period : entry.data.slug);
const description =
  entry.collection === 'now'
    ? entry.data.notes[0]?.text
    : entry.data.description;
const tags = collectionTags(entry, series, variant === 'archive');
const searchText = [entry.data.title, description, label, ...tags]
  .join(' ')
  .toLowerCase();
---

{variant === 'audio' && entry.collection === 'audio' ? (
  <a
    class="episode-row"
    href={address(entry)}
    data-entry-key={key}
    data-tags={JSON.stringify(tags)}
    data-search-text={searchText}
    hidden={initiallyHidden}
  >
    <div class="episode-copy">
      <div class="episode-meta">
        {entry.data.episode && (
          <span class="episode-number" aria-label={`第${entry.data.episode}期`}>
            EP.{entry.data.episode}
          </span>
        )}
        <span class="episode-series">
          {entry.data.series
            ? series.find((item) => item.id === entry.data.series)?.data.title
            : '声音手记'}
        </span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {dateLabel(entry.data.publishedAt)}
        </time>
      </div>
      <h3>{entry.data.title}</h3>
      <p>{description}</p>
    </div>
    <span class="episode-row-action" aria-hidden="true">
      ↗
    </span>
  </a>
) : (
  <a
    class:list={['row', { 'writing-row': variant === 'writing' }]}
    href={address(entry)}
    data-entry-key={key}
    data-tags={JSON.stringify(tags)}
    data-search-text={searchText}
    hidden={initiallyHidden}
  >
    <time datetime={entry.data.publishedAt.toISOString()}>
      {variant === 'writing'
        ? dateLabel(entry.data.publishedAt)
        : dateLabel(entry.data.publishedAt).slice(5)}
    </time>
    <span>
      <small>
        {variant === 'writing'
          ? label
          : { writing: '文字', audio: '声音', now: '此刻' }[entry.collection] +
            (label ? ' / ' + label : '')}
      </small>
      <strong>{entry.data.title}</strong>
      {variant === 'writing' && <p>{description}</p>}
    </span>
    <span class="arrow" aria-hidden="true">
      ↗
    </span>
  </a>
)}
