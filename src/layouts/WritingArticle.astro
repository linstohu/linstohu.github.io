---
import '../styles/pages/reading.css';
import { site } from '../lib/site';
import { dateLabel, searchMetadata, type Writing } from '../lib/content';
interface Props {
  entry: Writing;
  class?: string;
  categoryHref?: string;
  backLabel?: string;
}
const {
  entry,
  class: pageClass,
  categoryHref,
  backLabel = '返回文字列表',
} = Astro.props;
---

<div class:list={['reading-page', pageClass]}>
  <article
    class="reader article-paper"
    aria-labelledby="article-title"
    data-pagefind-body
  >
    <div class="article-path" data-pagefind-ignore>
      <a href="/writing/">← 文字</a>
      {categoryHref ? (
        <a class="article-category" href={categoryHref}>
          {entry.data.category}
        </a>
      ) : (
        entry.data.category && <span>{entry.data.category}</span>
      )}
    </div>
    <header
      class="article-head"
      data-pagefind-index-attrs="data-search-text"
      data-search-text={searchMetadata(entry)}
    >
      <slot name="title">
        <h1 id="article-title" data-pagefind-meta="title">
          {entry.data.title}
        </h1>
      </slot>
      <div class="byline" data-pagefind-ignore>
        <span>{site.author}</span>
        <slot name="source" />
        <time datetime={entry.data.publishedAt.toISOString()}>
          {dateLabel(entry.data.publishedAt)}
        </time>
        <slot name="source-link" />
        {entry.data.draft && <span>草稿预览</span>}
      </div>
    </header>
    <slot />
    {entry.data.videos.map((video) => (
      <section class="video-recommendation">
        <h2>延伸观看</h2>
        <a
          class="video-link"
          href={video.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="video-symbol" aria-hidden="true">
            ▷
          </span>
          <span>
            <strong>{video.title}</strong>
            <small>
              {video.creator}
              <br />
              站外视频 ↗
            </small>
          </span>
        </a>
        {video.description && <p>{video.description}</p>}
      </section>
    ))}
    {entry.data.appendix && (
      <details class="article-appendix">
        <summary>{entry.data.appendix.title}</summary>
        <ul>
          {entry.data.appendix.notes.map((note) => (
            <li>{note}</li>
          ))}
        </ul>
      </details>
    )}
  </article>
  <nav class="article-end" aria-label="文章末尾导航">
    <a href={categoryHref ?? '/writing/'}>← {backLabel}</a>
  </nav>
</div>
