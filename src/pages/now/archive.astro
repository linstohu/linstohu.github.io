---
import PageHeading from '../../components/ui/PageHeading.astro';
import '../../styles/pages/now.css';
import Base from '../../layouts/Base.astro';
import { loadContent, address } from '../../lib/content';
const { snapshots } = await loadContent();
const years = [
  ...new Set(snapshots.map((entry) => entry.data.period.slice(0, 4))),
];
---

<Base title="此刻归档" section="now">
  <section class="now-page">
    <PageHeading title="此刻归档" class="archive-heading">
      <a class="more" href="/now/">
        回到当前快照 →
      </a>
    </PageHeading>
    {years.length === 0 && <p class="empty-list">暂无历史快照。</p>}
    {years.map((year) => (
      <section class="snapshot-year">
        <h2>{year}</h2>
        <div class="snapshot-cards grid grid-cols-1 md:grid-cols-3">
          {snapshots
            .filter((entry) => entry.data.period.startsWith(year))
            .map((entry) => (
              <a href={address(entry)}>
                <time datetime={entry.data.publishedAt.toISOString()}>
                  {Number(entry.data.period.slice(-2))} 月
                </time>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.notes[0]?.text}</p>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
        </div>
      </section>
    ))}
  </section>
</Base>
