---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PromptedArticle from '../../layouts/PromptedArticle.astro';
import WritingArticle from '../../layouts/WritingArticle.astro';
import {
  loadContent,
  collectionTags,
  entryKey,
  type Writing,
} from '../../lib/content';
export async function getStaticPaths() {
  const { posts } = await loadContent();
  return posts.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}
interface Props {
  entry: Writing;
}
const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
---

<Base
  title={entry.data.title}
  section="writing"
  description={entry.data.description}
  entryKey={entryKey(entry)}
  filterTags={collectionTags(entry)}
  noindex={entry.data.draft}
  imageViewer={entry.rendered?.html.includes('image-open') ?? false}
>
  {entry.data.category === 'prompted' ? (
    <PromptedArticle
      entry={entry}
      rounds={remarkPluginFrontmatter.dialogueRounds ?? []}
    >
      <Content />
    </PromptedArticle>
  ) : (
    <WritingArticle entry={entry}>
      <div class="article-body markdown-body">
        <Content />
      </div>
    </WritingArticle>
  )}
</Base>
