---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 content/pages/about.md');
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  section="about"
  description={entry.data.description}
>
  <section class="about-page">
    <div class="collection-heading">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
    </div>
    <div class="about-opening">
      <div>
        <h2>{entry.data.greeting}</h2>
        {entry.data.intro.map((text) => (
          <p>{text}</p>
        ))}
      </div>
      <figure class="about-art">
        <img
          src={entry.data.image}
          width="900"
          height="480"
          alt="本站的山景插画，赭色落日下层层青绿山脊延伸至远处。"
        />
      </figure>
    </div>
    <div class="about-notes about-markdown">
      <Content />
    </div>
  </section>
</Base>
