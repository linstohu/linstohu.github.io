---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 content/pages/about.md');
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  section="about"
  description={entry.data.description}
>
  <section class="about-page">
    <div class="collection-heading">
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p>{entry.data.description}</p>}
    </div>
    {(entry.data.greeting ||
      entry.data.intro.length > 0 ||
      entry.data.image) && (
      <div class="about-opening">
        <div>
          {entry.data.greeting && <h2>{entry.data.greeting}</h2>}
          {entry.data.intro.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        {entry.data.image && (
          <figure class="about-art">
            <Artwork
              src={entry.data.image}
              variant="about"
              alt="本站的山景插画，赭色落日下层层青绿山脊延伸至远处。"
            />
          </figure>
        )}
      </div>
    )}
    {entry.body?.trim() && (
      <div class="about-notes about-markdown markdown-body">
        <Content />
      </div>
    )}
  </section>
</Base>
