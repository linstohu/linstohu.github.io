---
import PageHeading from '../components/ui/PageHeading.astro';
import '../styles/pages/about.css';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Artwork from '../components/Artwork.astro';
const entry = await getEntry('pages', 'about');
if (!entry) throw new Error('缺少 content/pages/about.md');
const { Content } = await render(entry);
---

<Base
  title={entry.data.title}
  section="about"
  description={entry.data.description}
  imageViewer={entry.rendered?.html.includes('image-open') ?? false}
>
  <section class="about-page">
    <PageHeading
      title={entry.data.title}
      description={entry.data.description}
    />
    {(entry.data.greeting ||
      entry.data.intro.length > 0 ||
      entry.data.image) && (
      <div class="about-opening grid grid-cols-1 md:grid-cols-[1.2fr_1fr]">
        <div>
          {entry.data.greeting && <h2>{entry.data.greeting}</h2>}
          {entry.data.intro.map((text) => (
            <p>{text}</p>
          ))}
        </div>
        {entry.data.image && (
          <figure class="about-art">
            <Artwork
              src={entry.data.image}
              variant="about"
              alt="本站的山景插画，赭色落日下层层青绿山脊延伸至远处。"
            />
          </figure>
        )}
      </div>
    )}
    {entry.body?.trim() && (
      <div class="about-notes about-markdown markdown-body grid grid-cols-1 md:grid-cols-[210px_minmax(0,1fr)]">
        <Content />
      </div>
    )}
  </section>
</Base>
